{
  "name": "mediagraph-assets",
  "version": "2.1.0",
  "description": "WordPress plugin for browsing and inserting Mediagraph assets",
  "private": true,
  "main": "admin/js/src/index.jsx",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf admin/js/dist",
    "lint": "eslint admin/js --ext .js,.jsx",
    "lint:fix": "eslint admin/js --ext .js,.jsx --fix",
    "test": "jest",
    "release": "./build-release.sh"
  },
  "keywords": [
    "wordpress",
    "mediagraph",
    "media",
    "assets",
    "dam"
  ],
  "author": "Mediagraph",
  "license": "GPL-2.0+",
  "devDependencies": {
    "@babel/core": "7.23.9",
    "@babel/preset-env": "7.23.9",
    "@babel/preset-react": "7.23.3",
    "babel-jest": "29.7.0",
    "babel-loader": "9.1.3",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "webpack": "5.90.3",
    "webpack-cli": "5.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/admin/js/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@wordpress/element$": "<rootDir>/admin/js/__tests__/mocks/element.js",
      "^@wordpress/i18n$": "<rootDir>/admin/js/__tests__/mocks/i18n.js"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
